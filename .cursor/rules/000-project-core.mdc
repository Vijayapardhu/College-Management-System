```
# Analytics Helper Functions
def calculate_attendance_percentage(student, subject=None, date_range=None):
    query = Attendance.objects.filter(student=student)
    if subject:
        query = query.filter(subject=subject)
    if date_range:
        query = query.filter(date__range=date_range)
    
    total_classes = query.count()
    if total_classes == 0:
        return 0
    
    attended_classes = query.filter(status=True).count()
    return round((attended_classes / total_classes) * 100, 2)

def get_department_performance(department):
    students = Student.objects.filter(course__department=department)
    performance_data = []
    
    for student in students:
        avg_marks = Result.objects.filter(student=student).aggregate(
            avg_marks=models.Avg('marks')
        )['avg_marks'] or 0
        
        attendance_pct = calculate_attendance_percentage(student)
        
        performance_data.append({
            'student': student,
            'average_marks': round(avg_marks, 2),
            'attendance_percentage': attendance_pct,
        })
    
    return performance_data
```

