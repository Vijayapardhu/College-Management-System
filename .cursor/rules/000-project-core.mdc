## Security Implementation Rules

### Authentication & Authorization
- Always validate user authentication and role permissions
- Use Django's built-in permission system
- Implement proper session management
- Add CSRF protection to all forms

```
# Permission Helper Pattern
def check_user_permission(user, required_types):
    """Check if user has required permissions"""
    if not user.is_authenticated:
        return False
    return user.user_type in required_types

def require_roles(allowed_roles):
    """Decorator for role-based access control"""
    def decorator(view_func):
        def wrapper(request, *args, **kwargs):
            if not check_user_permission(request.user, allowed_roles):
                messages.error(request, 'Access denied')
                return redirect('login')
            return view_func(request, *args, **kwargs)
        return wrapper
    return decorator

# Usage
@require_roles(['1', '2'])  # HOD and Faculty only
def protected_view(request):
    # View logic here
    pass
```

### File Upload Security
- Validate file types, sizes, and content
- Store uploads outside web-accessible directories
- Use secure file naming conventions
- Implement malware scanning when possible

```
# Secure File Upload Pattern
def handle_uploaded_file(uploaded_file, user, file_type='document'):
    # File size validation
    max_sizes = {
        'document': 5 * 1024 * 1024,    # 5MB for documents
        'image': 2 * 1024 * 1024,       # 2MB for images
        'video': 50 * 1024 * 1024,      # 50MB for videos
    }
    
    if uploaded_file.size > max_sizes.get(file_type, 5 * 1024 * 1024):
        raise ValidationError(f'File too large for {file_type}')
    
    # File type validation
    allowed_extensions = {
        'document': ['pdf', 'doc', 'docx', 'txt', 'ppt', 'pptx'],
        'image': ['jpg', 'jpeg', 'png', 'gif'],
        'video': ['mp4', 'avi', 'mov', 'wmv'],
    }
    
    file_extension = uploaded_file.name.split('.')[-1].lower()
    if file_extension not in allowed_extensions.get(file_type, []):
        raise ValidationError(f'File type not allowed for {file_type}')
    
    # Generate secure filename
    timestamp = timezone.now().strftime('%Y%m%d_%H%M%S')
    secure_filename = f"{user.id}_{timestamp}_{uploaded_file.name}"
    
    return secure_filename
```

